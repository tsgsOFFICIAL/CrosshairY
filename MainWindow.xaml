<Window x:Class="CrosshairY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrosshairY"
        mc:Ignorable="d"
        Title="Crosshair Y - CS2 Editor" Height="820" Width="500"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Header + Preview -->
            <TextBlock Text="Crosshair Y" FontSize="32" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="CS2-style Parametric Editor" FontSize="16" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Border Background="#111111" BorderBrush="#444444" BorderThickness="2" CornerRadius="12" Height="260" Width="260" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Canvas x:Name="PreviewCanvas" Background="Transparent"/>
            </Border>

            <!-- Core Shape Controls -->
            <TextBlock Text="Shape" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gap" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="GapSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GapSlider, StringFormat={}{0:0.0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Length" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="LengthSlider" Minimum="0" Maximum="100" Value="10" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=LengthSlider, StringFormat={}{0:0.0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Thickness" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="ThicknessSlider" Minimum="0" Maximum="10" Value="1" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:0.0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Outline & Features -->
            <TextBlock Text="Outline &amp; Extras" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>

            <CheckBox x:Name="OutlineCheck" Content="Draw Outline" IsChecked="True" Foreground="White" Margin="0,0,0,12" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Outline" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="OutlineSlider" Minimum="0" Maximum="5" Value="1" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OutlineSlider, StringFormat={}{0:0.0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <CheckBox x:Name="DotCheck" Content="Center Dot" Foreground="White" Margin="0,0,0,12" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
            <CheckBox x:Name="TStyleCheck" Content="T-Style (no top line)" Foreground="White" Margin="0,0,0,24" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>

            <!-- Color -->
            <TextBlock Text="Color" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Red" Foreground="#FF6666" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Green" Foreground="#66FF66" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Blue" Foreground="#6666FF" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Alpha" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="AlphaSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="Slider_Changed" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=AlphaSlider, StringFormat={}{0:0}}" Foreground="White" Background="#222222" Padding="6,4" TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="Copy Share Code" Click="CopyShareCode_Click" Width="190" Height="48" Margin="0,0,16,0" Background="#0099FF" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                <Button Content="Import Share Code" Click="ImportShareCode_Click" Width="190" Height="48" Background="#FF9900" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>

            <Button x:Name="ToggleBtn" Content="Toggle Overlay (Ctrl + F1)" Click="Toggle_Click" Height="56" Background="#00FFAA" Foreground="Black" FontSize="16" FontWeight="Bold"/>

        </StackPanel>
    </ScrollViewer>
</Window>