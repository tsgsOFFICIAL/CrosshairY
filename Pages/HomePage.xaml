<Page x:Class="CrosshairY.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CrosshairY.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Welcome to CrosshairY" 
                       Style="{StaticResource HeadingText}" 
                       Margin="0,0,0,8"/>
            <TextBlock Text="Customize your gaming crosshair with precision. Design, save, and switch between crosshairs instantly." 
                       Style="{StaticResource MutedText}" 
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"/>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="Open Designer" 
                        Style="{StaticResource PrimaryButton}" 
                        Margin="0,0,12,0" Click="OnOpenDesignerButtonClicked"/>
                <Button Content="Browse Crosshairs" 
                        Style="{StaticResource SecondaryButton}"
                        Click="OnBrowseCrosshairsButtonClicked"/>
            </StackPanel>

            <!-- Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Toggle Hotkey Card -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="M2,2 L14,2 L14,12 L2,12 Z M4,12 L4,14 L12,14 L12,12 M5,5 L5,9 M8,5 L8,9 M11,5 L11,9" 
                                  Stroke="{StaticResource PrimaryBrush}" 
                                  StrokeThickness="1.5" 
                                  Width="20" Height="20" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Toggle Hotkey" 
                                       Style="{StaticResource SubheadingText}"/>
                        </StackPanel>
                        <TextBlock Text="Set a global hotkey to toggle the crosshair overlay on/off" 
                                   Style="{StaticResource MutedText}" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Current Hotkey" 
                                   Style="{StaticResource BodyText}" 
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource SecondaryBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="16,8" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding ToggleCrosshairString, FallbackValue='None'}" 
                                           Foreground="{StaticResource ForegroundBrush}" 
                                           FontFamily="Consolas" 
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Button Content="Unbind" Style="{StaticResource SecondaryButton}" Click="OnUnbindHotkeyButtonClicked" Margin="0,0,8,0"/>
                            <Button Content="Change" Style="{StaticResource PrimaryButton}" Click="OnChangeHotkeyButtonClicked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Active Crosshair Card -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Active Crosshair" 
                                   Style="{StaticResource SubheadingText}" 
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Currently selected crosshair preview" 
                                   Style="{StaticResource MutedText}" 
                                   Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource SecondaryBrush}" 
                                    CornerRadius="8" 
                                    Width="96" Height="96" 
                                    Margin="0,0,16,0"
                                    ClipToBounds="True">
                                <!-- Crosshair Preview Canvas -->
                                <Canvas x:Name="ActiveCrosshairCanvas"></Canvas>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Crosshair.CrosshairName}" 
                                           Style="{StaticResource BodyText}" 
                                           FontWeight="Medium"/>
                                <TextBlock Text="{Binding Crosshair.Description}" 
                                           Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Crosshairs Card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent Crosshairs" 
                               Style="{StaticResource SubheadingText}" 
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Your recently used crosshairs" 
                               Style="{StaticResource MutedText}" 
                               Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding RecentCrosshairs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SecondaryBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="12"
                                    Width="192"
                                    Margin="0,0,12,12">

                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Background="{StaticResource SecondaryBrush}"
                                            CornerRadius="6"
                                            Width="128"
                                            Height="128"
                                            Margin="0,0,0,8"
                                            ClipToBounds="True">

                                            <Canvas
                                                Loaded="OnRecentCrosshairCanvasLoaded"
                                                Tag="{Binding}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding CrosshairName}"
                                           Style="{StaticResource MutedText}" 
                                           FontSize="11" 
                                           HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>