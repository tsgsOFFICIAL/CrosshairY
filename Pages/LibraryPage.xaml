<Page x:Class="CrosshairY.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CrosshairY.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Library"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                CornerRadius="6" 
                HorizontalAlignment="Left"
                Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="MyCrosshairsTab" 
                             Content="My Crosshairs" 
                             IsChecked="True"
                             Padding="16,10"
                             Foreground="{StaticResource ForegroundBrush}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Border" 
                                                Background="Transparent" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton x:Name="CommunityTab" 
                             Content="Community Crosshairs"
                             Padding="16,10"
                             Foreground="{StaticResource ForegroundBrush}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Border" 
                                                Background="Transparent" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CrosshairsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" 
                                Width="280" 
                                Margin="0,0,16,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Crosshair Preview -->
                                <Border Grid.Column="0" 
                                        Background="{StaticResource SecondaryBrush}" 
                                        CornerRadius="6" 
                                        Width="64" Height="64" 
                                        Margin="0,0,16,0">
                                    <Canvas>
                                        <Rectangle Canvas.Left="30" Canvas.Top="18" Width="4" Height="12" Fill="{Binding Color}"/>
                                        <Rectangle Canvas.Left="30" Canvas.Top="34" Width="4" Height="12" Fill="{Binding Color}"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="30" Width="12" Height="4" Fill="{Binding Color}"/>
                                        <Rectangle Canvas.Left="34" Canvas.Top="30" Width="12" Height="4" Fill="{Binding Color}"/>
                                    </Canvas>
                                </Border>

                                <!-- Info and Actions -->
                                <StackPanel Grid.Column="1">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" 
                                                   Style="{StaticResource BodyText}" 
                                                   FontWeight="Medium"/>
                                        <Button HorizontalAlignment="Right" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Padding="0">
                                            <Path Data="M12,2 L15,8 L22,9 L17,14 L18,21 L12,18 L6,21 L7,14 L2,9 L9,8 Z" 
                                                  Stroke="{StaticResource MutedForegroundBrush}" 
                                                  StrokeThickness="1.5" 
                                                  Width="16" Height="16" 
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding Author}" 
                                               Style="{StaticResource MutedText}" 
                                               FontSize="12"
                                               Margin="0,0,0,12"
                                               Visibility="{Binding AuthorVisibility}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Apply" 
                                                Style="{StaticResource PrimaryButton}" 
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Hotkey" 
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Background="Transparent" 
                                                BorderThickness="0" 
                                                Padding="8,6"
                                                Visibility="{Binding DeleteVisibility}">
                                            <Path Data="M3,6 L5,6 L5,19 C5,20 6,21 7,21 L17,21 C18,21 19,20 19,19 L19,6 L21,6 M8,6 L8,4 C8,3 9,2 10,2 L14,2 C15,2 16,3 16,4 L16,6 M10,11 L10,17 M14,11 L14,17" 
                                                  Stroke="{StaticResource DestructiveBrush}" 
                                                  StrokeThickness="1.5" 
                                                  Width="14" Height="14" 
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>