<Page x:Class="CrosshairY.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:settings="clr-namespace:CrosshairY.Models"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Library"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <!-- Delete Button Style - visible only when My Crosshairs tab is active -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Red"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=MyCrosshairsTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Save Current Button Style -->
        <Style x:Key="SaveCurrentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=MyCrosshairsTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TAB HEADER + SAVE CURRENT BUTTON -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TAB HEADER -->
            <Border Background="{StaticResource SecondaryBrush}"
                    CornerRadius="6"
                    HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal">

                    <!-- MY CROSSHAIRS -->
                    <RadioButton x:Name="MyCrosshairsTab"
                                 GroupName="LibraryTabs"
                                 Content="My Crosshairs"
                                 IsChecked="True"
                                 Padding="16,10"
                                 Foreground="{StaticResource ForegroundBrush}">

                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Border"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- COMMUNITY -->
                    <RadioButton x:Name="CommunityTab"
                                 GroupName="LibraryTabs"
                                 Content="Community Crosshairs"
                                 Padding="16,10"
                                 Foreground="{StaticResource ForegroundBrush}">

                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Border"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- SAVE CURRENT BUTTON -->
            <Button x:Name="SaveCurrentButton"
                    Content="Save Current"
                    HorizontalAlignment="Right"
                    Grid.Column="1"
                    Style="{StaticResource SaveCurrentButtonStyle}"
                    Click="OnSaveButtonClicked"/>
        </Grid>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CrosshairsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type settings:CrosshairSettings}">

                        <Border Style="{StaticResource Card}"
                                Width="320"
                                Margin="0,0,16,16">                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PREVIEW -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource SecondaryBrush}"
                                        CornerRadius="6"
                                        Width="64"
                                        Height="64"
                                        Margin="0,0,16,0"
                                        ClipToBounds="True">

                                    <Canvas x:Name="PreviewCanvas"
                                            Width="64"
                                            Height="64"
                                            Loaded="OnPreviewCanvasLoaded"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>

                                <!-- INFO -->
                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="{Binding CrosshairName}"
                                               FontWeight="Medium"
                                               Style="{StaticResource BodyText}"/>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Margin="0,0,0,12"
                                               Foreground="Gray"/>

                                    <!-- Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Apply"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="0,0,8,0"
                                                Tag="{Binding}"
                                                Click="OnApplyButtonClicked"/>

                                        <Button Content="Hotkey"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Margin="0,0,8,0"
                                                Tag="{Binding}"
                                                Click="OnHotkeyButtonClicked"/>

                                        <!-- DELETE BUTTON - only visible on My Crosshairs tab -->
                                        <Button Content="Delete"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                Tag="{Binding}"
                                                Click="OnDeleteButtonClicked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>